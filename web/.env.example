# Sub-folder the site is served from. "/Oribi_Demo" for the GitHub Pages demo, empty on www.oribi.com.na.
NEXT_PUBLIC_BASE_PATH=
# Public address, used for social previews.
NEXT_PUBLIC_SITE_URL=https://www.oribi.com.na
# Address of the enquiry API, for example https://api.oribi.com.na. Leave empty to keep the form in preview mode.
NEXT_PUBLIC_ENQUIRY_API=
